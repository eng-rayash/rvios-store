# ═══════════════════════════════════════════════════════════
#  نسخة للمشاركة — انسخها إلى .env واملأ القيم
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
# ٣٠٠٠ منفذ شائع: أي مشروع آخر على الجهاز قد يحجزه، وويندوز
# يسمح بربطين عليه فيستلم الأخيرُ الطلبات بلا خطأ ولا تحذير —
# فتصل فحوصك إلى تطبيق غريب وتفشل بأخطاء لا معنى لها. عندها:
#   PORT=3100 npm start
#   RVIOS_TEST_URL=http://localhost:3100 npm test
PORT=3000

# العنوان العام — يُستخدم في Open Graph وsitemap
PUBLIC_URL=

# ── إرسال رموز التحقق (§٢.٥) ─────────────────────────────
# console = يطبع الرمز (تطوير) · whatsapp · sms
OTP_PROVIDER=console

# واتساب Cloud API — من لوحة Meta for Developers
META_TOKEN=
# معرّف الرقم — الظاهر أسفل الرقم في WhatsApp Manager
WA_PHONE_ID=
# معرّف حساب واتساب للأعمال — لقراءة القوالب
WA_WABA_ID=
WA_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_TEMPLATE=otp_ar
WHATSAPP_LANG=ar

# بوابة SMS بديلة
SMS_URL=
SMS_METHOD=GET
SMS_AUTH=

# ── أسرار إلزامية في الإنتاج ─────────────────────────────
# كلمة مرور لوحة الإدارة — الإقلاع يتوقف إن بقيت الافتراضية
RVIOS_ADMIN_PASS=

# فلفل تجزئة رموز التحقق — بدونه تفقد التجزئة قيمتها
OTP_PEPPER=

# ملح بصمة الزيارة — ثابت كي لا تتضخّم أرقام الزوّار
VISIT_SALT=

# ── قاعدة البيانات ───────────────────────────────────────
# رابط PostgreSQL. إلزامي في الإنتاج — الإقلاع يتوقف بدونه.
# مثال: postgresql://user:pass@host:5432/dbname
# للتطوير المحلي بلا TLS أضف ?sslmode=disable
DATABASE_URL=

# ── مسارات (اختيارية) ────────────────────────────────────
# مجلد البيانات — الصور المرفوعة والنسخ. في الحاوية /data
DATA_DIR=
BACKUP_DIR=
# عنوان الاستماع — 0.0.0.0 داخل الحاويات
HOST=0.0.0.0

# ── واتساب: أسماء بديلة مقبولة ───────────────────────────
# مرادفان مقبولان لـ META_TOKEN و WA_PHONE_ID — استعمل أيّهما
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
META_API_VERSION=v21.0

# ── بوابة SMS: جسم الطلب ونصّه ───────────────────────────
SMS_BODY=
SMS_TEXT=رمز التحقق في RVIOS Store: {code}

# ═══════════════════════════════════════════════════════════
#  ضبط دقيق — كلها اختيارية، والقيم المذكورة هي الافتراضية
# ═══════════════════════════════════════════════════════════
# رموز التحقق
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_WINDOW_MINUTES=60
OTP_PER_PHONE=5
# الحدّ على العنوان يحمي رصيد الرسائل من الإساءة. وفي التطوير
# ترفعه إلى ٢٠٠: مجموعة الفحص كلها تعمل من عنوان واحد وتسجّل
# دخولاً في كل ملف، فتستنزف حدّ الإنتاج ويفشل ملفٌ متأخّر لسبب
# لا علاقة له به. ارفعه محلياً في .env ولا ترفعه في الإنتاج.
OTP_PER_IP=20

# الجلسات
SESSION_DAYS=30
ADMIN_SESSION_HOURS=8

# الحدود
MAX_BODY_BYTES=6291456
UPLOAD_MAX_BYTES=2097152
COMPRESSION_MIN_BYTES=1024

# ── تخزين الصور ────────────────────────────────────────
#  local = قرص الخادم تحت DATA_DIR/uploads.
#          يحتاج قرصاً دائماً على منصة النشر، وإلا اختفت
#          صور التجار مع كل إصدار جديد.
#  r2    = Cloudflare R2 (متوافق مع S3). التطبيق يصير بلا
#          حالة، فلا حاجة لقرص دائم ولا تتأثر الصور بالنشر.
STORAGE_DRIVER=local

# مفاتيح R2 — من Cloudflare › R2 › Manage API Tokens.
# لا تضعها في أي مكان غير هذا الملف أو متغيّرات المنصة.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# نطاق السلة العام (r2.dev أو نطاق مخصّص). بدونه تبقى السلة
# خاصة ويمرّ الخادم بكل صورة بنفسه — أبطأ وأغلى.
R2_PUBLIC_URL=

# النسخ الاحتياطي — يحتاج pg_dump على المضيف
BACKUP_ENABLED=0
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14

# طابور المهام الخلفية
JOBS_INTERVAL_MS=15000
JOBS_BATCH=10
JOBS_MAX_ATTEMPTS=5

# ── الترحيل التدريجي (Next) ───────────────────────────────
# التطبيق واحد يشغّل خادمين: Next على المنفذ العام، والخادم
# القديم خلفه على PORT. يُمرّر Next إليه ما لم يُرحّل بعد —
# ‏/api و/uploads وصفحات الدخول واللوحات — والقائمة في
# next.config.ts. أي اختلاف بين هذا وPORT يعني تمريراً إلى
# منفذ لا أحد عليه: صفحات تعمل وأخرى تسقط بلا رسالة مفهومة.
LEGACY_ORIGIN=http://localhost:3100

# منفذ Next نفسه (العام). في الإنتاج تضبطه المنصة عادةً.
WEB_PORT=3001
