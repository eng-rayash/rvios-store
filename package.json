{
  "name": "rvios-store",
  "version": "1.0.0",
  "description": "منصة متاجر إلكترونية متعددة المستأجرين — RVIOS Store",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --no-warnings --watch server/server.js",
    "dev:web": "next dev -p 3001",
    "build": "node scripts/check-theme.mjs && next build",
    "start": "node scripts/start.mjs",
    "start:server": "node --no-warnings server/server.js",
    "start:web": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme.mjs",
    "check:server-deps": "node scripts/check-server-deps.mjs",
    "check:wa": "node --no-warnings ops/check-whatsapp.mjs",
    "check:storage": "node --no-warnings ops/check-storage.mjs",
    "seed": "node --no-warnings server/seed.js",
    "reset": "node --no-warnings server/seed.js --reset",
    "seed:circletech": "node --no-warnings scripts/seed-circletech.mjs",
    "seed:nibras": "node --no-warnings scripts/seed-nibras.mjs",
    "seed:velar": "node --no-warnings scripts/seed-velar.mjs",
    "seed:demo": "npm run seed:circletech && npm run seed:nibras && npm run seed:velar",
    "migrate": "node --no-warnings -e \"import('./server/db.js').then(m => m.migrate()).then(() => import('./server/pg.js')).then(m => m.db.close()).then(() => console.log('✔ طُبّق المخطّط'))\"",
    "readiness": "node --no-warnings test/readiness.mjs",
    "test": "npm run reset && npm run test:suites",
    "test:suites": "node --no-warnings test/run.mjs",
    "backup": "node --no-warnings ops/backup.mjs",
    "backup:list": "node --no-warnings ops/restore.mjs --list",
    "restore": "node --no-warnings ops/restore.mjs",
    "secrets": "node --no-warnings ops/secrets.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
